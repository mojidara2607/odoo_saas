<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inherits the BASE template (account.report_invoice_document) and
        keeps every `<t name="...">` anchor intact, replacing only the inner
        text. This is required for compatibility with l10n_gcc_invoice, which
        defines a primary="True" view that xpaths on `<t name='invoice_title'>`
        (and on the named info-block divs). If we deleted those anchors the
        GCC view would fail to install with:
            Element '<t name="invoice_title">' cannot be located in parent view
    -->
    <template id="report_invoice_document_inherit_tax_label"
              inherit_id="account.report_invoice_document"
              priority="100">

        <!-- Customer invoice titles: posted / draft / cancel, non-proforma -->
        <xpath expr="//t[@name='invoice_title']" position="replace">
            <t name="invoice_title">Tax Invoice</t>
        </xpath>
        <xpath expr="//t[@name='draft_invoice_title']" position="replace">
            <t name="draft_invoice_title">Tax Invoice</t>
        </xpath>
        <xpath expr="//t[@name='cancelled_invoice_title']" position="replace">
            <t name="cancelled_invoice_title">Tax Invoice</t>
        </xpath>

        <!-- Customer invoice titles: posted / draft / cancel, proforma (Preview) -->
        <xpath expr="//t[@name='proforma_invoice_title']" position="replace">
            <t name="proforma_invoice_title">Tax Invoice</t>
        </xpath>
        <xpath expr="//t[@name='draft_proforma_invoice_title']" position="replace">
            <t name="draft_proforma_invoice_title">Tax Invoice</t>
        </xpath>
        <xpath expr="//t[@name='cancelled_proforma_invoice_title']" position="replace">
            <t name="cancelled_proforma_invoice_title">Tax Invoice</t>
        </xpath>

        <!--
            Invoice Date and Due Date in DDMMYY format (e.g. 12 May 2026 -> 120526).
            Targets the value div by `t-field` attribute; GCC adds bilingual labels
            inside the parent <div name="invoice_date"/> but does not touch the
            value div, so this xpath matches in both vanilla and GCC trees.
            To use a separated form, change '%d%m%y' to '%d-%m-%y' (12-05-26)
            or '%d/%m/%y' (12/05/26).
        -->
        <xpath expr="//div[@t-field='o.invoice_date']" position="replace">
            <div t-out="o.invoice_date and o.invoice_date.strftime('%d%m%y') or ''">120526</div>
        </xpath>
        <xpath expr="//div[@t-field='o.invoice_date_due']" position="replace">
            <div t-out="o.invoice_date_due and o.invoice_date_due.strftime('%d%m%y') or ''">120526</div>
        </xpath>
    </template>

</odoo>
