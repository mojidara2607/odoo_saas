<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_kitchen_screen_odoo.SendToKitchenButton"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('more-btn')]" position="before">
            <button class="btn btn-primary btn-lg border-0 text-truncate"
                    t-on-click="() => this.sendToKitchenScreen()">
                <i class="fa fa-cutlery me-1"/>
                <span>Send to Kitchen</span>
            </button>
        </xpath>
    </t>
</templates>
