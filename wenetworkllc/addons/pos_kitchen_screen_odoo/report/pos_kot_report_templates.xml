<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pos_kot_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="table_name" t-value="(o.table_id and o.table_id.display_name) or '-'"/>
                <t t-set="restaurant_name" t-value="(o.company_id and o.company_id.name) or (o.config_id and o.config_id.name) or '-'"/>
                <t t-set="branch_name" t-value="(o.config_id and o.config_id.name) or ''"/>
                <t t-set="order_ref" t-value="o.pos_reference or o.name or '-'"/>
                <t t-set="date_str" t-value="o.date_order and context_timestamp(o.date_order).strftime('%d-%b-%Y') or '-'"/>
                <t t-set="time_str" t-value="o.date_order and context_timestamp(o.date_order).strftime('%H:%M:%S') or '-'"/>
                <t t-set="cashier_name" t-value="o._get_kot_cashier_name()"/>
                <t t-set="guest_count" t-value="o._get_kot_guest_count()"/>
                <t t-set="print_time" t-value="o._get_kot_print_time()"/>
                <t t-set="kot_lines" t-value="o._get_kot_report_lines()"/>
                <t t-set="total_qty" t-value="sum(l.qty for l in kot_lines)"/>

                <div style="font-family: 'Courier New', Courier, monospace; color: #000; line-height: 1.3; padding: 0; margin: 0; width: 100%; font-size: 12px; page-break-after: always;">

                    <!-- ===================== HEADER ===================== -->
                    <div style="text-align: center; font-size: 11px; letter-spacing: 1px;">********************************</div>
                    <div style="text-align: center; font-weight: 900; font-size: 20px; margin: 4px 0 2px 0; letter-spacing: 3px;">
                        K. O. T.
                    </div>
                    <div style="text-align: center; font-weight: bold; font-size: 11px; letter-spacing: 2px; margin-bottom: 4px;">
                        KITCHEN ORDER TICKET
                    </div>
                    <div style="text-align: center; font-size: 11px; letter-spacing: 1px;">********************************</div>

                    <div style="text-align: center; font-weight: bold; text-transform: uppercase; font-size: 13px; margin-top: 4px;">
                        <span t-out="restaurant_name"/>
                    </div>
                    <t t-if="branch_name and branch_name != restaurant_name">
                        <div style="text-align: center; font-size: 11px;">
                            <span t-out="branch_name"/>
                        </div>
                    </t>

                    <div style="border-top: 2px dashed #000; margin: 6px 0 4px 0;"></div>

                    <!-- ===================== ORDER META ===================== -->
                    <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                        <tr>
                            <td style="padding: 1px 0; font-weight: bold; width: 38%;">KOT NO.</td>
                            <td style="padding: 1px 0; font-weight: bold; font-size: 13px;">
                                <span t-out="order_ref"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 1px 0; font-weight: bold;">DATE</td>
                            <td style="padding: 1px 0;"><span t-out="date_str"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 1px 0; font-weight: bold;">TIME</td>
                            <td style="padding: 1px 0;"><span t-out="time_str"/></td>
                        </tr>
                        <t t-if="cashier_name">
                            <tr>
                                <td style="padding: 1px 0; font-weight: bold;">SERVER</td>
                                <td style="padding: 1px 0; font-weight: bold;"><span t-out="cashier_name"/></td>
                            </tr>
                        </t>
                    </table>

                    <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>

                    <!-- ===================== TABLE BIG BLOCK ===================== -->
                    <table style="width: 100%; border-collapse: collapse; margin: 4px 0;">
                        <tr>
                            <td style="width: 38%; vertical-align: middle; font-weight: bold; font-size: 11px;">TABLE NO.</td>
                            <td style="vertical-align: middle; font-weight: 900; font-size: 26px; line-height: 1; text-align: left;">
                                <span t-out="table_name"/>
                            </td>
                        </tr>
                        <t t-if="guest_count">
                            <tr>
                                <td style="font-weight: bold; font-size: 11px; padding-top: 2px;">PAX / COVERS</td>
                                <td style="font-size: 14px; font-weight: 900; padding-top: 2px;">
                                    <span t-out="('%d' % guest_count)"/>
                                </td>
                            </tr>
                        </t>
                    </table>

                    <div style="border-top: 2px dashed #000; margin: 4px 0;"></div>

                    <!-- ===================== ITEMS ===================== -->
                    <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                        <thead>
                            <tr style="font-weight: 900;">
                                <td style="width: 18%; text-align: left; padding: 2px 0; border-bottom: 1px solid #000; font-size: 11px;">QTY</td>
                                <td style="text-align: left; padding: 2px 0; border-bottom: 1px solid #000; font-size: 11px;">PARTICULARS</td>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="kot_lines" t-as="line">
                                <t t-set="line_note" t-value="o._get_kot_line_note(line)"/>
                                <tr>
                                    <td style="text-align: left; padding: 5px 0 0 0; vertical-align: top; font-weight: 900; font-size: 16px; line-height: 1.1;">
                                        <span t-out="('%g' % line.qty)"/><span style="font-size: 12px;">x</span>
                                    </td>
                                    <td style="text-align: left; padding: 5px 0 0 0; vertical-align: top; font-weight: bold; font-size: 13px; text-transform: uppercase; line-height: 1.2;">
                                        <span t-out="o._get_kot_product_name(line)"/>
                                    </td>
                                </tr>
                                <t t-if="line_note">
                                    <tr>
                                        <td></td>
                                        <td style="text-align: left; padding: 1px 0 2px 0; font-style: italic; font-size: 11px; line-height: 1.2;">
                                            &#9658;&#160;<span t-out="line_note"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <tr>
                                <td colspan="2" style="border-top: 1px solid #000; padding-top: 2px;"></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ===================== TOTAL ===================== -->
                    <div style="text-align: right; font-weight: 900; font-size: 13px; margin: 4px 0;">
                        TOTAL ITEMS:&#160;<span t-out="('%g' % total_qty)"/>
                    </div>

                    <div style="border-top: 2px dashed #000; margin: 4px 0;"></div>

                    <!-- ===================== FOOTER ===================== -->
                    <div style="text-align: center; font-weight: 900; font-size: 13px; margin: 6px 0 2px 0; letter-spacing: 2px;">
                        *** N E W &#160; O R D E R ***
                    </div>
                    <div style="text-align: center; font-size: 10px; margin-top: 4px;">
                        Printed: <span t-out="print_time"/>
                    </div>
                    <div style="text-align: center; font-size: 11px; letter-spacing: 1px; margin-top: 4px;">
                        ********************************
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
